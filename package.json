{
  "name": "aess",
  "version": "0.1.0",
  "private": true,
  "description": "AESS: a 42 mm grid, snap-stacking bin system for 3D printing, with a browser generator",
  "keywords": [
    "3d-printing",
    "storage",
    "bins",
    "stackable",
    "42mm-grid",
    "parametric",
    "generator",
    "manifold",
    "bambu-lab"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.js 8080",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/smoke.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "build:set": "node scripts/build-set.js",
    "build:starter": "node scripts/build-set.js sets/starter.txt dist/starter-set --plate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "manifold-3d": "3.5.5",
    "playwright": "1.65.1"
  }
}
